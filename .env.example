# 应用配置
APP_NAME=安行伴-重庆试点
ENVIRONMENT=development

# 数据库配置（必填）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@YOUR_HOST:3306/anbanx?charset=utf8mb4

# 安全密钥（必填，生产环境请使用强随机字符串）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=replace-this-with-a-secure-random-string-in-production

# 短信服务提供商
SMS_PROVIDER=mock

# 试点城市
PILOT_CITY=Chongqing

# 导游功能范围
GUIDE_SCOPE=knowledge_limited
